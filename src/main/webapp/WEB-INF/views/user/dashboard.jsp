<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../common/header.jspf" %>
<section class="welcome-row"><div><span class="eyebrow"><span class="status-dot"></span> DAILY READOUT / <c:out value="${pageDate}" /></span><h1>Find your <em>rhythm.</em></h1><p>Progress is built one deliberate session at a time.</p></div><a class="button button-lime" href="${pageContext.request.contextPath}/workouts"><i data-lucide="plus"></i> Log workout</a></section>
<section class="dashboard-grid">
  <article class="panel ring-panel"><div class="panel-heading"><div><span class="eyebrow">CALORIE OUTPUT</span><h2>Today in motion</h2></div><span class="panel-mark">01 / 03</span></div><div class="rings-layout"><div class="ring-stack" aria-label="Today's calorie and activity progress"><svg viewBox="0 0 220 220" role="img"><circle class="ring-track ring-outer" cx="110" cy="110" r="91"/><circle class="ring-progress ring-outer" cx="110" cy="110" r="91" style="stroke-dasharray:${todayPercent * 5.72} 572"/><circle class="ring-track ring-middle" cx="110" cy="110" r="72"/><circle class="ring-progress ring-middle" cx="110" cy="110" r="72" style="stroke-dasharray:${minutePercent * 4.52} 452"/><circle class="ring-track ring-inner" cx="110" cy="110" r="53"/><circle class="ring-progress ring-inner" cx="110" cy="110" r="53" style="stroke-dasharray:${goalPercent * 3.33} 333"/></svg><div class="ring-center"><strong class="count-up" data-value="${todayCalories}"><c:out value="${todayCalories}" /></strong><span>KCAL</span></div></div><div class="ring-legend"><div><span class="legend-swatch lime"></span><span>Calories</span><strong><c:out value="${todayCalories}" /> <small>/ 600</small></strong></div><div><span class="legend-swatch violet"></span><span>Active time</span><strong><c:out value="${todayMinutes}" /> <small>/ 45 MIN</small></strong></div><div><span class="legend-swatch coral"></span><span>Monthly goal</span><strong><c:out value="${monthlyCalories}" /> <small>/ <c:out value="${activeGoalTarget}" /> KCAL</small></strong></div></div></div></article>
  <article class="panel streak-panel"><div class="panel-heading"><div><span class="eyebrow">CONSISTENCY</span><h2>Stay in motion</h2></div><i class="flame-icon" data-lucide="flame"></i></div><div class="streak-number"><strong class="count-up" data-value="${streakDays}"><c:out value="${streakDays}" /></strong><span>DAY STREAK</span></div><div class="heatmap-heading"><span>LAST 28 DAYS</span><span>LESS <i class="heat-cell"></i><i class="heat-cell heat-1"></i><i class="heat-cell heat-2"></i><i class="heat-cell heat-3"></i> MORE</span></div><div class="heatmap" role="img" aria-label="Workout consistency over the last 28 days"><c:forEach items="${heatmapDays}" var="day"><span class="heat-cell heat-${day.level}" title="${day.date}: ${day.minutes} minutes"></span></c:forEach></div><div class="heatmap-months"><span>4 WEEKS AGO</span><span>TODAY</span></div></article>
  <article class="panel chart-panel"><div class="panel-heading"><div><span class="eyebrow">LOAD / 7 DAYS</span><h2>Weekly calories</h2></div><span class="chart-unit">KCAL</span></div><div class="chart-wrap"><canvas id="weeklyChart" aria-label="Calories burned by day for the last week"></canvas></div></article>
  <article class="panel type-panel"><div class="panel-heading"><div><span class="eyebrow">TRAINING MIX</span><h2>Where you move</h2></div><a class="text-link" href="${pageContext.request.contextPath}/workouts">Details <i data-lucide="arrow-up-right"></i></a></div><div class="type-chart-wrap"><canvas id="typeChart" aria-label="Calories by workout type"></canvas><div class="donut-center"><strong><c:out value="${monthWorkoutCount}" /></strong><span>SESSIONS</span></div></div></article>
</section>
<section class="panel progress-chart-panel"><div class="panel-heading"><div><span class="eyebrow">CUMULATIVE LOAD / 7 DAYS</span><h2>Momentum over time</h2></div><span class="chart-unit">KCAL</span></div><div class="chart-wrap-progress"><canvas id="progressChart" aria-label="Cumulative calories for the last week"></canvas></div></section>
<section class="lower-grid"><div class="section-block"><div class="section-heading"><div><span class="eyebrow">RECENT SIGNAL</span><h2>Latest sessions</h2></div><a class="text-link" href="${pageContext.request.contextPath}/workouts">All workouts <i data-lucide="arrow-right"></i></a></div><div class="session-list"><c:forEach items="${recentWorkouts}" var="workout"><div class="session-row"><span class="session-icon"><i data-lucide="${workout.type == 'RUNNING' ? 'footprints' : workout.type == 'STRENGTH' ? 'dumbbell' : workout.type == 'YOGA' ? 'flower-2' : 'activity'}"></i></span><span class="session-name"><strong><c:out value="${workout.type}" /></strong><small><c:out value="${workout.workoutDate}" /> · <c:out value="${workout.durationMinutes}" /> min · <c:out value="${workout.intensity}" /></small></span><strong class="mono-number"><c:out value="${Math.round(workout.calories)}" /> <small>KCAL</small></strong></div></c:forEach><c:if test="${empty recentWorkouts}"><div class="empty-state">Your first session will show up here.</div></c:if></div></div>
<aside class="side-stack"><div class="section-heading"><div><span class="eyebrow">PERSONAL SIGNAL</span><h2>Next best moves</h2></div></div><div class="recommendation-list"><c:forEach items="${recommendations}" var="recommendation" varStatus="loop"><div class="recommendation-item"><span class="recommend-index">0<c:out value="${loop.count}" /></span><p><c:out value="${recommendation}" /></p></div></c:forEach></div><div class="challenge-mini"><span class="eyebrow">OPEN CHALLENGE</span><c:forEach items="${challenges}" var="challenge" varStatus="loop"><c:if test="${loop.first}"><strong><c:out value="${challenge.title}" /></strong><div class="progress-track"><span style="width:${challenge.progressPercent}%"></span></div><small><c:out value="${challenge.progress}" /> / <c:out value="${challenge.targetValue}" /> progress</small></c:if></c:forEach><a href="${pageContext.request.contextPath}/challenges">Explore challenges <i data-lucide="arrow-up-right"></i></a></div></aside></section>
<script>window.FITNESS_API='${pageContext.request.contextPath}/api/stats';</script>
<%@ include file="../common/footer.jspf" %>