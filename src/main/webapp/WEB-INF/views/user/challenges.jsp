<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="page-heading"><span class="eyebrow">SHARED MOMENTUM / 03</span><h1>Go further, <em>together.</em></h1><p>Join a community challenge. Logged workouts automatically move your progress.</p></section>
<section class="challenge-grid"><c:forEach items="${challenges}" var="challenge" varStatus="loop"><article class="challenge-card challenge-tone-${loop.index % 3}"><div class="challenge-card-top"><span class="challenge-number">0<c:out value="${loop.count}" /></span><span class="status-tag"><c:out value="${challenge.status}" /></span></div><h2><c:out value="${challenge.title}" /></h2><p><c:out value="${challenge.description}" /></p><div class="challenge-dates"><span><i data-lucide="calendar"></i> <c:out value="${challenge.startDate}" /></span><span>TO <c:out value="${challenge.endDate}" /></span></div><div class="progress-meta"><span>YOUR CONTRIBUTION</span><strong><c:out value="${challenge.progress}" /> <small>/ <c:out value="${challenge.targetValue}" /></small></strong></div><div class="progress-track challenge-progress"><span style="width:${challenge.progressPercent}%"></span></div><div class="challenge-bottom"><span><i data-lucide="users"></i> <c:out value="${challenge.participantCount}" /> participants</span><a class="text-link" href="?leaderboard=${challenge.id}">Leaderboard <i data-lucide="arrow-up-right"></i></a></div><div class="challenge-actions"><c:choose><c:when test="${challenge.joined}"><form method="post" action="${pageContext.request.contextPath}/challenges"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="challengeId" value="${challenge.id}"><button class="button button-quiet" name="action" value="leave" type="submit">Leave challenge</button></form></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/challenges"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="challengeId" value="${challenge.id}"><button class="button button-lime" name="action" value="join" type="submit">Join challenge <i data-lucide="arrow-right"></i></button></form></c:otherwise></c:choose></div></article></c:forEach></section>
<c:if test="${not empty leaderboard}"><section class="section-block leaderboard-panel"><div class="section-heading"><div><span class="eyebrow">LIVE BOARD / CHALLENGE #<c:out value="${leaderboardId}" /></span><h2>Top performers</h2></div><i data-lucide="trophy" class="panel-icon"></i></div><div class="podium"><c:forEach items="${leaderboard}" var="entry" varStatus="loop"><div class="podium-row"><span class="podium-rank">0<c:out value="${loop.count}" /></span><strong><c:out value="${entry.name}" /></strong><span class="mono-number"><c:out value="${entry.progress}" /> / <c:out value="${entry.target}" /></span><div class="progress-track"><span style="width:${entry.target > 0 ? entry.progress * 100 / entry.target : 0}%"></span></div></div></c:forEach><c:if test="${empty leaderboard}"><p class="empty-state">No entries yet. Be the first to join.</p></c:if></div></section></c:if>
<%@ include file="../common/footer.jspf" %>