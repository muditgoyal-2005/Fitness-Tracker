<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="page-heading"><span class="eyebrow">INTENTION / 02</span><h1>Set a <em>target.</em></h1><p>Choose a measurable outcome and a time window that fits your training.</p></section>
<section class="content-split"><div class="panel form-panel"><div class="panel-heading"><div><span class="eyebrow">NEW GOAL</span><h2>Make it measurable</h2></div><i data-lucide="target" class="panel-icon"></i></div><form method="post" action="${pageContext.request.contextPath}/goals" class="form-stack"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="save"><label>Goal name<input name="goalType" required maxlength="80" placeholder="Burn 3,000 kcal this month"></label><label>Target value<input type="number" name="target" min="1" step="1" required placeholder="3000"></label><div class="form-grid"><label>Start date<input type="date" name="startDate" value="${today}" required></label><label>End date<input type="date" name="endDate" value="${monthEnd}" required></label></div><button class="button button-lime" type="submit">Set this goal <i data-lucide="arrow-right"></i></button></form></div>
<div class="goal-list-wrap"><div class="section-heading"><div><span class="eyebrow">ACTIVE INTENTIONS</span><h2>Your goals</h2></div></div><c:forEach items="${goals}" var="goal"><article class="goal-item"><div class="goal-item-head"><span class="goal-icon"><i data-lucide="flag"></i></span><span><strong><c:out value="${goal.goalType}" /></strong><small><c:out value="${goal.startDate}" /> — <c:out value="${goal.endDate}" /></small></span><span class="status-tag"><c:out value="${goal.status}" /></span></div><div class="goal-target"><strong><c:out value="${goal.currentValue}" /></strong><small> / <c:out value="${goal.targetValue}" /> KCAL</small></div><div class="progress-track"><span style="width:${goal.progressPercent}%"></span></div><details class="inline-edit"><summary>Edit target</summary><form method="post" action="${pageContext.request.contextPath}/goals" class="form-grid"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="${goal.id}"><label>Name<input name="goalType" value="${goal.goalType}" required maxlength="80"></label><label>Value<input type="number" name="target" value="${goal.targetValue}" min="1" required></label><label>Start<input type="date" name="startDate" value="${goal.startDate}" required></label><label>End<input type="date" name="endDate" value="${goal.endDate}" required></label><button class="button button-quiet" type="submit">Save changes</button></form></details><form method="post" action="${pageContext.request.contextPath}/goals" data-confirm="Remove this goal?"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${goal.id}"><button class="text-button danger-text" type="submit">Delete goal</button></form></article></c:forEach><c:if test="${empty goals}"><div class="empty-state">No active goals yet. Set one measurable intention.</div></c:if></div></section>
<%@ include file="../common/footer.jspf" %>