<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="page-heading"><span class="eyebrow">COMMUNITY NOTEBOOK / 04</span><h1>Share what <em>works.</em></h1><p>Submit a training tip or workout plan. An administrator reviews each post before it appears.</p></section><section class="content-split"><div class="panel form-panel"><div class="panel-heading"><div><span class="eyebrow">NEW SUBMISSION</span><h2>Pass it forward</h2></div><i data-lucide="notebook-pen" class="panel-icon"></i></div><form method="post" action="${pageContext.request.contextPath}/content" class="form-stack"><input type="hidden" name="_csrf" value="${csrfToken}"><label>Title<input name="title" maxlength="160" required placeholder="A tip that changed my long runs"></label><label>Your note<textarea name="body" rows="8" maxlength="5000" required placeholder="Write your tip, cue, or workout plan..."></textarea></label><button class="button button-lime" type="submit">Submit for review <i data-lucide="send"></i></button></form></div><div class="content-history"><div class="section-heading"><div><span class="eyebrow">YOUR CONTRIBUTIONS</span><h2>Submission history</h2></div></div><c:forEach items="${contentItems}" var="item"><article class="submission-item"><div class="submission-top"><span class="status-tag status-${item.status}"><c:out value="${item.status}" /></span><small><c:out value="${item.submittedAt}" /></small></div><h3><c:out value="${item.title}" /></h3><p><c:out value="${item.body}" /></p></article></c:forEach><c:if test="${empty contentItems}"><div class="empty-state">Your approved and pending notes will appear here.</div></c:if></div></section>
<%@ include file="../common/footer.jspf" %>