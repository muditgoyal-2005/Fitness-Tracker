<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="page-heading page-heading-row"><div><span class="eyebrow">MOVEMENT LOG / 01</span><h1>Every session <em>counts.</em></h1><p>Capture the work. Your calorie estimate updates with workout type, intensity, and body weight.</p></div><button class="button button-lime" type="button" data-open-dialog="workoutDialog"><i data-lucide="plus"></i> Add session</button></section>
<section class="panel form-panel"><div class="panel-heading"><div><span class="eyebrow">NEW ENTRY</span><h2>Log a workout</h2></div><span class="panel-mark">CALCULATED IN REAL TIME</span></div><form method="post" action="${pageContext.request.contextPath}/workouts" class="workout-form form-grid"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="save"><label>Workout type<select name="type" required><c:forEach items="${types}" var="type"><option value="${type}"><c:out value="${type}" /></option></c:forEach></select></label><label>Duration <span class="input-unit">MIN</span><input type="number" name="duration" min="1" max="1440" required placeholder="35"></label><label>Session date<input type="date" name="workoutDate" value="${today}" required></label><label class="intensity-field">Intensity <span class="intensity-value" id="intensityValue">MEDIUM</span><select name="intensity" id="intensitySelect"><c:forEach items="${intensities}" var="intensity"><option value="${intensity}" <c:if test="${intensity == 'MEDIUM'}">selected</c:if>><c:out value="${intensity}" /></option></c:forEach></select><span class="intensity-rail"><span></span></span></label><label class="form-span">Notes <span class="input-unit">OPTIONAL</span><input type="text" name="notes" maxlength="500" placeholder="Route, focus, or how it felt"></label><div class="form-span form-submit-row"><span class="form-hint"><i data-lucide="sparkles"></i> Calories are estimated using your profile and MET values.</span><button class="button button-lime" type="submit">Save session <i data-lucide="arrow-right"></i></button></div></form></section>
<section class="section-block table-section"><div class="section-heading"><div><span class="eyebrow">SESSION ARCHIVE</span><h2>Your workouts</h2></div><span class="panel-mark">PAGE <c:out value="${page}" /></span></div><div class="table-wrap"><table><thead><tr><th>DATE</th><th>TYPE</th><th>DURATION</th><th>INTENSITY</th><th>CALORIES</th><th>NOTES</th><th></th></tr></thead><tbody><c:forEach items="${workouts}" var="workout"><tr><td class="mono-number"><c:out value="${workout.workoutDate}" /></td><td><span class="type-pill"><c:out value="${workout.type}" /></span></td><td><c:out value="${workout.durationMinutes}" /> min</td><td><span class="intensity-tag intensity-${workout.intensity}"><c:out value="${workout.intensity}" /></span></td><td class="mono-number"><c:out value="${Math.round(workout.calories)}" /> kcal</td><td><c:out value="${workout.notes}" /></td><td class="row-actions"><button type="button" class="icon-button edit-workout" aria-label="Edit workout" data-id="${workout.id}" data-type="${workout.type}" data-duration="${workout.durationMinutes}" data-intensity="${workout.intensity}" data-date="${workout.workoutDate}" data-notes="${workout.notes}"><i data-lucide="pencil"></i></button><form method="post" action="${pageContext.request.contextPath}/workouts" data-confirm="Delete this workout?"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${workout.id}"><button class="icon-button danger-button" type="submit" aria-label="Delete workout"><i data-lucide="trash-2"></i></button></form></td></tr></c:forEach><c:if test="${empty workouts}"><tr><td colspan="7" class="empty-state">No workouts on this page. Your log starts with one session.</td></tr></c:if></tbody></table></div><div class="pagination"><c:if test="${page > 1}"><a class="text-link" href="?page=${page - 1}"><i data-lucide="arrow-left"></i> Newer</a></c:if><a class="text-link" href="?page=${page + 1}">Older <i data-lucide="arrow-right"></i></a></div></section>
<dialog class="modal" id="workoutDialog"><form method="post" action="${pageContext.request.contextPath}/workouts" class="modal-content"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="save"><input type="hidden" name="id" id="editWorkoutId"><div class="panel-heading"><div><span class="eyebrow">SESSION EDITOR</span><h2>Update workout</h2></div><button class="icon-button" type="button" data-close-dialog aria-label="Close"><i data-lucide="x"></i></button></div><label>Type<select name="type" id="editWorkoutType"><c:forEach items="${types}" var="type"><option value="${type}"><c:out value="${type}" /></option></c:forEach></select></label><div class="form-grid"><label>Duration in minutes<input type="number" name="duration" id="editWorkoutDuration" min="1" max="1440" required></label><label>Date<input type="date" name="workoutDate" id="editWorkoutDate" required></label></div><label>Intensity<select name="intensity" id="editWorkoutIntensity"><c:forEach items="${intensities}" var="intensity"><option value="${intensity}"><c:out value="${intensity}" /></option></c:forEach></select></label><label>Notes<input name="notes" id="editWorkoutNotes" maxlength="500"></label><button class="button button-lime button-wide" type="submit">Save changes <i data-lucide="check"></i></button></form></dialog>
<%@ include file="../common/footer.jspf" %>