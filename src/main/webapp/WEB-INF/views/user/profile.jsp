<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="page-heading"><span class="eyebrow">ACCOUNT / 05</span><h1>Your profile, <em>your pace.</em></h1><p>Keep the details that shape your training estimates current.</p></section><section class="profile-layout"><div class="profile-aside"><div class="profile-avatar"><c:out value="${fn:substring(sessionScope.user.name,0,1)}" /></div><span class="eyebrow">ACTIVE MEMBER</span><h2><c:out value="${sessionScope.user.name}" /></h2><p><c:out value="${sessionScope.user.email}" /></p><div class="profile-meta"><span>ACCOUNT TYPE</span><strong><c:out value="${sessionScope.user.role}" /></strong></div><div class="profile-meta"><span>MEMBER SINCE</span><strong><c:out value="${memberSince}" /></strong></div></div><div class="panel form-panel"><div class="panel-heading"><div><span class="eyebrow">PROFILE DETAILS</span><h2>Personal information</h2></div></div><form method="post" action="${pageContext.request.contextPath}/profile" class="form-stack"><input type="hidden" name="_csrf" value="${csrfToken}"><label>Full name<input name="name" value="${sessionScope.user.name}" required maxlength="100"></label><label>Email address<input type="email" name="email" value="${sessionScope.user.email}" required maxlength="190"></label><div class="form-divider"><span>CHANGE PASSWORD</span><small>Leave both fields blank to keep your current password.</small></div><label>Current password<input type="password" name="currentPassword" autocomplete="current-password"></label><label>New password<input type="password" name="newPassword" autocomplete="new-password" minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,72}"></label><button class="button button-lime" type="submit">Save profile <i data-lucide="check"></i></button></form></div></section>
<%@ include file="../common/footer.jspf" %>