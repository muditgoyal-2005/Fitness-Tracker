<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="welcome-row admin-welcome"><div><span class="eyebrow"><span class="status-dot"></span> OPERATIONS / LIVE</span><h1>System <em>pulse.</em></h1><p>Engagement, training volume, and community activity at a glance.</p></div><span class="active-counter"><i class="live-mark"></i><strong><c:out value="${activeUsers}" default="0" /></strong> SESSIONS ONLINE</span></section>
<section class="kpi-grid"><article class="kpi-tile"><span class="eyebrow">MEMBERS</span><strong class="count-up" data-value="${userCount}"><c:out value="${userCount}" /></strong><span class="kpi-foot"><i data-lucide="users"></i> Registered profiles</span></article><article class="kpi-tile kpi-lime"><span class="eyebrow">WORKOUT LOGS</span><strong class="count-up" data-value="${workoutCount}"><c:out value="${workoutCount}" /></strong><span class="kpi-foot"><i data-lucide="activity"></i> Sessions recorded</span></article><article class="kpi-tile kpi-violet"><span class="eyebrow">CHALLENGE ENTRIES</span><strong class="count-up" data-value="${participantCount}"><c:out value="${participantCount}" /></strong><span class="kpi-foot"><i data-lucide="trophy"></i> Active participants</span></article><article class="kpi-tile kpi-coral"><span class="eyebrow">REVIEW QUEUE</span><strong class="count-up" data-value="${pendingCount}"><c:out value="${pendingCount}" /></strong><span class="kpi-foot"><i data-lucide="inbox"></i> Awaiting decision</span></article></section>
<section class="admin-dashboard-grid"><article class="panel admin-chart-panel"><div class="panel-heading"><div><span class="eyebrow">ENGAGEMENT / 7 DAYS</span><h2>Platform activity</h2></div><span class="chart-unit">LIVE DATA</span></div><div class="chart-wrap chart-wrap-tall"><canvas id="adminChart" aria-label="Platform engagement statistics"></canvas></div><div class="admin-chart-legend"><span><i class="legend-swatch lime"></i> Workout logs</span><span><i class="legend-swatch violet"></i> Challenge participation</span><span><i class="legend-swatch coral"></i> New members</span></div></article><aside class="panel activity-panel"><div class="panel-heading"><div><span class="eyebrow">SYSTEM ACTIVITY</span><h2>Live feed</h2></div><span class="live-feed-label"><span class="status-dot"></span> POLLING</span></div><div class="activity-feed" id="activityFeed" data-endpoint="${pageContext.request.contextPath}/api/activity"><c:forEach items="${activity}" var="event"><article class="activity-event"><span class="activity-mark"><i data-lucide="activity"></i></span><div><strong><c:out value="${event.action}" /></strong><p><c:out value="${event.details}" /></p><small><c:out value="${event.userName}" default="System" /> · <c:out value="${event.createdAt}" /></small></div></article></c:forEach><c:if test="${empty activity}"><div class="empty-state">Activity will appear here as the platform is used.</div></c:if></div><span class="poll-caption">Refreshes every 5 seconds</span></aside></section>
<div class="admin-shortcuts"><a href="${pageContext.request.contextPath}/admin/users"><i data-lucide="users"></i><span>Manage members</span><i data-lucide="arrow-up-right"></i></a><a href="${pageContext.request.contextPath}/admin/content"><i data-lucide="inbox"></i><span>Review submissions</span><i data-lucide="arrow-up-right"></i></a><a href="${pageContext.request.contextPath}/admin/settings"><i data-lucide="sliders-horizontal"></i><span>System settings</span><i data-lucide="arrow-up-right"></i></a></div>
<script>window.FITNESS_API='${pageContext.request.contextPath}/api/stats';window.ACTIVITY_API='${pageContext.request.contextPath}/api/activity';</script>
<%@ include file="../common/footer.jspf" %>