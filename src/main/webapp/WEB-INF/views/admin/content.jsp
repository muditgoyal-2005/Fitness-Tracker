<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="page-heading"><span class="eyebrow">ADMIN / COMMUNITY REVIEW</span><h1>Give good ideas <em>a signal.</em></h1><p>Approve helpful member-submitted tips and plans. Rejected content stays out of the community stream.</p></section><section class="review-list"><c:forEach items="${contentItems}" var="item"><article class="panel review-card"><div class="review-meta"><span class="status-tag status-${item.status}"><c:out value="${item.status}" /></span><span><c:out value="${item.authorName}" /> · <c:out value="${item.submittedAt}" /></span><span class="panel-mark">#<c:out value="${item.id}" /></span></div><h2><c:out value="${item.title}" /></h2><p class="review-body"><c:out value="${item.body}" /></p><c:if test="${item.status == 'PENDING'}"><div class="review-actions"><form method="post" action="${pageContext.request.contextPath}/admin/content"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="id" value="${item.id}"><button class="button button-lime" name="status" value="APPROVED" type="submit"><i data-lucide="check"></i> Approve</button></form><form method="post" action="${pageContext.request.contextPath}/admin/content"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="id" value="${item.id}"><button class="button button-quiet" name="status" value="REJECTED" type="submit"><i data-lucide="x"></i> Reject</button></form></div></c:if></article></c:forEach><c:if test="${empty contentItems}"><div class="empty-state">The review queue is clear.</div></c:if></section>
<%@ include file="../common/footer.jspf" %>