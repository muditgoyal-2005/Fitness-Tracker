<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="page-heading"><span class="eyebrow">ADMIN / PLATFORM CONFIGURATION</span><h1>System <em>controls.</em></h1><p>Runtime settings are stored as key-value pairs and applied without a redeploy.</p></section><section class="settings-layout"><div class="panel form-panel"><div class="panel-heading"><div><span class="eyebrow">UPDATE SETTING</span><h2>Configuration</h2></div><i data-lucide="sliders-horizontal" class="panel-icon"></i></div><form method="post" action="${pageContext.request.contextPath}/admin/settings" class="form-stack"><input type="hidden" name="_csrf" value="${csrfToken}"><label>Setting key<input name="key" required maxlength="100" pattern="[a-zA-Z0-9_.-]+" placeholder="site_name"></label><label>Setting value<input name="value" required maxlength="500" placeholder="PULSE / Athlete HUD"></label><button class="button button-lime" type="submit">Save setting <i data-lucide="save"></i></button></form></div><div class="settings-list"><div class="section-heading"><div><span class="eyebrow">PERSISTED VALUES</span><h2>Current configuration</h2></div></div><c:forEach items="${settings}" var="setting"><div class="setting-row"><span class="setting-key"><c:out value="${setting.key}" /></span><strong><c:out value="${setting.value}" /></strong><span class="setting-state"><i data-lucide="check"></i> ACTIVE</span></div></c:forEach></div></section>
<%@ include file="../common/footer.jspf" %>