<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jspf" %>
<section class="page-heading page-heading-row"><div><span class="eyebrow">ADMIN / MEMBERS</span><h1>Member <em>directory.</em></h1><p>Create accounts, update roles, or remove inactive profiles.</p></div><button class="button button-lime" type="button" data-open-dialog="createUserDialog"><i data-lucide="user-plus"></i> Add member</button></section>
<section class="panel table-panel"><div class="table-toolbar"><form method="get" action="${pageContext.request.contextPath}/admin/users" class="search-form"><i data-lucide="search"></i><input type="search" name="q" value="${query}" placeholder="Search names or email"><button class="button button-quiet" type="submit">Search</button></form><span class="panel-mark">PAGE <c:out value="${page}" /></span></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>MEMBER</th><th>EMAIL</th><th>ROLE</th><th>WEIGHT</th><th>CREATED</th><th>ACTIONS</th></tr></thead><tbody><c:forEach items="${users}" var="member"><tr><td><strong><c:out value="${member.name}" /></strong></td><td><c:out value="${member.email}" /></td><td><span class="role-badge role-${member.role}"><c:out value="${member.role}" /></span></td><td><c:out value="${member.weightKg}" /> kg</td><td><c:out value="${member.id}" /></td><td class="row-actions"><button type="button" class="icon-button edit-user" aria-label="Edit member" data-id="${member.id}" data-name="${member.name}" data-email="${member.email}" data-role="${member.role}"><i data-lucide="pencil"></i></button><form method="post" action="${pageContext.request.contextPath}/admin/users" data-confirm="Delete this member and their associated records?"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${member.id}"><button type="submit" class="icon-button danger-button" aria-label="Delete member"><i data-lucide="trash-2"></i></button></form></td></tr></c:forEach><c:if test="${empty users}"><tr><td colspan="6" class="empty-state">No members match that search.</td></tr></c:if></tbody></table></div><div class="pagination"><c:if test="${page > 1}"><a class="text-link" href="?q=${query}&page=${page - 1}"><i data-lucide="arrow-left"></i> Previous</a></c:if><a class="text-link" href="?q=${query}&page=${page + 1}">Next page <i data-lucide="arrow-right"></i></a></div></section>
<dialog class="modal" id="createUserDialog"><form method="post" action="${pageContext.request.contextPath}/admin/users" class="modal-content"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="save"><input type="hidden" name="id" id="adminUserId"><div class="panel-heading"><div><span class="eyebrow">MEMBER RECORD</span><h2 id="adminUserTitle">Create member</h2></div><button class="icon-button" type="button" data-close-dialog aria-label="Close"><i data-lucide="x"></i></button></div><label>Name<input name="name" id="adminUserName" maxlength="100" required></label><label>Email<input type="email" name="email" id="adminUserEmail" maxlength="190" required></label><label>Role<select name="role" id="adminUserRole"><c:forEach items="${roles}" var="role"><option value="${role}"><c:out value="${role}" /></option></c:forEach></select></label><label>Password <span class="input-unit">REQUIRED FOR NEW / OPTIONAL TO RESET</span><input type="password" name="password" minlength="8" autocomplete="new-password"></label><button class="button button-lime button-wide" type="submit">Save member <i data-lucide="check"></i></button></form></dialog>
<%@ include file="../common/footer.jspf" %>