<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create profile / Pulse HUD</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/base.css"><script src="https://unpkg.com/lucide@latest"></script></head>
<body class="auth-page"><main class="auth-shell"><section class="auth-art auth-art-register"><div class="auth-brand"><span class="brand-icon">P</span>PULSE <span>/ ATHLETE HUD</span></div><div class="auth-art-copy"><span class="eyebrow"><span class="status-dot"></span> START WHERE YOU ARE</span><h1>Build your<br><em>own pace.</em></h1><p>Small sessions. Real momentum. A stronger picture of your progress.</p></div><div class="auth-telemetry"><div class="telemetry-wave"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><div><strong>WEEK ONE / DAY ONE</strong><small>YOUR NEXT CHAPTER STARTS HERE</small></div></div><span class="auth-orbit orbit-one"></span><span class="auth-orbit orbit-two"></span></section><section class="auth-form-side"><div class="auth-form-wrap"><div class="mobile-auth-brand"><span class="brand-icon">P</span> PULSE / HUD</div><span class="eyebrow">NEW MEMBER <span class="auth-line"></span> 02</span><h2>Start your<br>baseline.</h2><p class="auth-subtitle">Create a profile. Tune it as you go.</p><c:if test="${not empty flashMessage}"><div class="form-alert" role="alert"><c:out value="${flashMessage}" /></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/auth/register" class="form-stack"><input type="hidden" name="_csrf" value="${csrfToken}"><label>Full name<input name="name" type="text" autocomplete="name" required maxlength="100" placeholder="Your name"></label><label>Email address<input name="email" type="email" autocomplete="email" required maxlength="190" placeholder="you@example.com"></label><label>Password<input name="password" type="password" autocomplete="new-password" required minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,72}" title="Use at least 8 characters with uppercase, lowercase, and a number."></label><button class="button button-lime button-wide" type="submit">Create your profile <i data-lucide="arrow-up-right"></i></button></form><div class="auth-switch">Already training here? <a href="${pageContext.request.contextPath}/auth/login">Sign in <i data-lucide="arrow-right"></i></a></div></div></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script><script>window.lucide?.createIcons();</script></body></html>