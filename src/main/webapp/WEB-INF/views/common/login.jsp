<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in / Pulse HUD</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/base.css"><script src="https://unpkg.com/lucide@latest"></script></head>
<body class="auth-page"><main class="auth-shell"><section class="auth-art"><div class="auth-brand"><span class="brand-icon">P</span>PULSE <span>/ ATHLETE HUD</span></div><div class="auth-art-copy"><span class="eyebrow"><span class="status-dot"></span> YOUR TRAINING, IN SIGNAL</span><h1>Make every<br><em>rep count.</em></h1><p>One clear view of your work, your rhythm, and what comes next.</p></div><div class="auth-telemetry"><div class="telemetry-wave"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><div><strong>37° 46' 49.8" N</strong><small>CONSISTENCY OVER INTENSITY</small></div></div><span class="auth-orbit orbit-one"></span><span class="auth-orbit orbit-two"></span></section>
<section class="auth-form-side"><div class="auth-form-wrap"><div class="mobile-auth-brand"><span class="brand-icon">P</span> PULSE / HUD</div><span class="eyebrow">MEMBER ACCESS <span class="auth-line"></span> 01</span><h2>Welcome<br>back.</h2><p class="auth-subtitle">Pick up where your last session left off.</p>
<c:if test="${not empty flashMessage}"><div class="form-alert" role="alert"><c:out value="${flashMessage}" /></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/auth/login" class="form-stack"><input type="hidden" name="_csrf" value="${csrfToken}"><label>Email address<input name="email" type="email" autocomplete="email" required maxlength="190" placeholder="you@example.com"></label><label>Password<input name="password" type="password" autocomplete="current-password" required></label><button class="button button-lime button-wide" type="submit">Enter your workspace <i data-lucide="arrow-up-right"></i></button></form>
<div class="auth-switch">New to the movement? <a href="${pageContext.request.contextPath}/auth/register">Create an account <i data-lucide="arrow-right"></i></a></div><div class="demo-access"><span class="mono-label">DEMO ADMIN</span><span>admin@fit.com</span><span class="mono-label">PASSWORD</span><span>Admin@123</span></div></div></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script><script>window.lucide?.createIcons();</script></body></html>